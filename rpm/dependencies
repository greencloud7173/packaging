# Debian package name -> Fedora package name, for the names that differ. A
# dash drops the dependency. A name that is not listed is used as it is, which
# covers the Cutefish packages themselves and the ones Fedora names the same
# way.
#
# rpm/build.sh translates both Build-Depends and Depends with this file.
# Anything the build cannot find in Fedora 44 fails loudly at configure time,
# so a wrong line here costs a build rather than a bad package.

# Debian's build helpers have no counterpart; rpmbuild replaces them.
debhelper-compat -
dh-cargo -
dh-python -
dbus-daemon dbus-tools
dpkg-dev -
equivs -
devscripts -
debhelper -

# Build tools.
cmake cmake
ninja-build ninja-build
generate-ninja gn
pkg-config pkgconf-pkg-config
python3 python3
perl perl
ruby ruby
gperf gperf
unifdef unifdef
gtk-update-icon-cache gtk-update-icon-cache
clang clang

# Rust. Fedora has no librust-*-dev packages; the crates come from crates.io.
cargo cargo
rustc rust

